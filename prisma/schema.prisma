datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Parámetros globales y factores editables por el Administrador
model PricingParameter {
  id          String   @id @default(cuid())
  key         String   @unique // ej: "C_BASE_HOUR", "R_BASE_M2", "OVERHEAD_PCT"
  name        String
  category    String   // "BASE", "COMPLEXITY", "FLOOR", "RISK", "FREQUENCY", "SUPPLIES", "EQUIPMENT"
                       // (EXTERIOR) "EXTERIOR", "DEBRIS", "MOBILIZATION"
  value       Float
  unit        String   // "USD/h", "m2/h", "multiplier", "pct" (EXTERIOR) "USD/m3", "USD/trip"
  explanation String   // Texto que se muestra en la UI para explicar este factor
  updatedAt   DateTime @updatedAt
}

// 2. Cabecera de la Cotización
model Quote {
  id                 String          @id @default(cuid())
  clientName         String
  facilityName       String
  latitude           Float?          // NUEVO: Opcional para futuros mapas (Análisis Espacial)
  longitude          Float?          // NUEVO: Opcional para futuros mapas
  facilityType       String          // OFFICE, HEALTH, INDUSTRIAL, RESIDENTIAL
  floorMaterial      String          // TILE, VINYL, CARPET, MARBLE
  areaM2             Float
  bathroomsCount     Int             @default(0)
  windowsM2          Float           @default(0)
  riskLevel          String          // LOW, MEDIUM, HIGH
  trafficLevel       String          // LOW, MEDIUM, HIGH
  disinfectionLevel  String          // BASIC, STANDARD_SPOT, CLINICAL
  frequencyType      String          // SPOT, WEEKLY, MONTHLY_DAILY
  eventsPerMonth     Float
  
  // Resultados calculados
  effectiveRateM2H   Float           // Productividad ajustada (m2/h)
  hoursPerEvent      Float
  totalHoursMonth    Float
  directCost         Float
  overheadCost       Float
  totalCost          Float
  marginPct          Float
  subtotalPrice      Float
  ivaAmount          Float
  finalPrice         Float
  pricePerM2         Float

  // Snapshot de los parámetros usados en ese momento (JSONB en Postgres)
  parameterSnapshot  Json
  
  // NUEVO (unificación): tipo de cotización. Las existentes quedan como INTERIOR por defecto.
  quoteType          String          @default("INTERIOR") // "INTERIOR" | "EXTERIOR"

  // NUEVO (unificación): detalles de limpieza exterior (solo se llena si quoteType = "EXTERIOR")
  exteriorDetails    ExteriorQuoteDetails?

  lineItems          QuoteLineItem[]
  createdAt          DateTime        @default(now())
}

// 3. Líneas de desglose explicables para la interfaz
model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category    String  // "LABOR", "SUPPLIES", "EQUIPMENT", "OVERHEAD", "MARGIN", "DISCOUNT_SURCHARGE"
                      // (EXTERIOR) "DEBRIS_DISPOSAL", "MOBILIZATION"
  concept     String
  formulaUsed String
  explanation String
  amountUsd   Float
}

// 4. NUEVO: Detalles específicos de Limpieza EXTERIOR
model ExteriorQuoteDetails {
  id      String @id @default(cuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Tipo de servicio (múltiple: DESBROCE, BARRIDO_CALLES, RETIRO_ESCOMBROS)
  servicesRequested String[]

  // Dimensiones
  areaM2       Float
  linearMeters Float? // para barrido de calles/aceras

  // Condición del terreno
  vegetationLevel String  // LIGHT, MEDIUM, SEVERE
  terrainSlope    String  // FLAT, MODERATE, STEEP
  accessibility   String  // MACHINERY, MANUAL_ONLY, MIXED
  hasTrees        Boolean @default(false)

  // Escombros
  debrisVolumeM3     Float?
  debrisType         String? // CONSTRUCTION, VEGETAL, MIXED, DOMESTIC
  volquetasEstimated Float?

  // Logística
  distanceToDumpKm   Float?
  mobilizationNeeded Boolean @default(false)

  // Factores aplicados (snapshot del cálculo)
  baseRateM2       Float
  vegetationFactor Float
  slopeFactor      Float
  accessFactor     Float

  // Resultados calculados
  effectiveRateM2    Float
  cleaningCost       Float
  debrisDisposalCost Float
  mobilizationCost   Float
  totalExteriorCost  Float

  createdAt DateTime @default(now())
}
